# ==============================================================================
# CONFIGURATION D'ENVIRONNEMENT - SAAS ENTRETIEN CAMPUS FRANCE
# AVERTISSEMENT : Ce fichier contient des exemples de valeurs fictives.
# Ne commitez JAMAIS de vraies clés secrètes dans votre dépôt git.
# ==============================================================================

# 1. APPLICATION
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. SUPABASE (Authentification & Base de données PostgreSQL avec RLS)
# Clé publique (accessible navigateur) : soumise aux politiques Row Level Security
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.exemple_cle_anon_publique

# Clé secrète de service (STRICTEMENT RÉSERVÉE AU SERVEUR) : bypass RLS pour tâches admin
# IMPORTANT : NE JAMAIS PRÉFIXER CETTE VARIABLE PAR NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.exemple_cle_service_role_strictement_serveur

# 3. OPENAI / TCHAVI API (Utilisée exclusivement côté serveur dans les Route Handlers)
# IMPORTANT : NE JAMAIS PRÉFIXER CETTE VARIABLE PAR NEXT_PUBLIC_
# Option A : Clé officielle OpenAI (ex: sk-proj-...)
OPENAI_API_KEY=sk-proj-exemple_cle_openai_serveur_uniquement
# Option B (Tchavi - Mobile Money) : Définir OPENAI_BASE_URL=https://tchavi.com/api/v1 et votre clé Tchavi
# OPENAI_BASE_URL=https://tchavi.com/api/v1
# TCHAVI_API_KEY=votre_cle_tchavi
OPENAI_MODEL_INTERVIEW=gpt-4o-mini
OPENAI_MODEL_REPORT=gpt-4o
OPENAI_MODEL_STT=whisper-1
OPENAI_MODEL_TTS=tts-1
OPENAI_VOICE=nova

# 4. GESTION DES DÉLAIS ET TIMEOUTS (en millisecondes)
TIMEOUT_AUTH_MS=10000
TIMEOUT_AI_TURN_MS=20000
TIMEOUT_AUDIO_UPLOAD_MS=45000
TIMEOUT_AUDIO_TRANSCRIBE_MS=60000
TIMEOUT_FINAL_REPORT_MS=45000

# 5. PASSERELLE DE PAIEMENT (En attente de connexion marchande officielle)
# Valeurs possibles : 'not_configured' | 'wave' | 'orange_money' | 'stripe'
PAYMENT_GATEWAY_PROVIDER=not_configured
WAVE_API_KEY=
ORANGE_MONEY_API_KEY=
